# ==========================================
# CLIPMIND AI CONFIGURATION ENVIRONMENT FILE
# ==========================================

# 1. Spring Boot Backend Database Configuration
# Default uses in-memory H2. Uncomment below for MySQL production deployment:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/clipmind_db?useSSL=false&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=password
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# 2. Security & JWT Token Configurations
CLIPMIND_JWT_SECRET=clipmind_ai_processing_platform_secure_jwt_secret_key_2026_spring_boot_react_ffmpeg_milestone
CLIPMIND_JWT_EXPIRATION_MS=86400000

# 3. Media Processing & FFmpeg Paths (Auto-discovered on Windows/Linux by default)
CLIPMIND_FFMPEG_PATH=ffmpeg
CLIPMIND_FFPROBE_PATH=ffprobe

# 4. Speech-to-Text & AI Model Configurations
CLIPMIND_WHISPER_MODEL=base
CLIPMIND_AI_API_KEY=

# 5. Frontend API Configuration (Vite / Next.js)
VITE_API_URL=http://localhost:8080/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api