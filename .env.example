POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clipmind
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipmind
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipmind
# REQUIRED: Groq API key used for Whisper transcription and summarization.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# REQUIRED: JWT signing key. Generate a strong, unique value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# Hours that an authenticated media URL stays valid (served via <video>/<img>).
MEDIA_TOKEN_EXPIRE_HOURS=1

# Frontend (optional, Vite). Empty string (or unset) = same-origin requests,
# proxied by the dev server or nginx in production.
# VITE_API_URL=http://localhost:8000
