POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clipmind
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipmind
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipmind
SECRET_KEY=change-me-in-production
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Frontend (optional, Vite). Empty string (or unset) = same-origin requests,
# proxied by the dev server or nginx in production.
# VITE_API_URL=http://localhost:8000
