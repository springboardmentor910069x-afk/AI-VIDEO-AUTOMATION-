# ==============================================================================
# ClipMind AI - Cloud & Production Environment Configuration
# ==============================================================================

# Server Environment
ENVIRONMENT=production
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas Cloud / Self-Hosted)
# ------------------------------------------------------------------------------
# MongoDB Atlas Cloud Connection String:
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clipmind_db?retryWrites=true&w=majority
MONGODB_DB_NAME=clipmind_db

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# AI Inference Engine (Groq High-Speed Cloud LPU)
# ------------------------------------------------------------------------------
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Speech-to-Text Model Selection
WHISPER_MODEL=tiny.en
WHISPER_CLOUD_ENABLED=true
CPU_THREADS=4

# ------------------------------------------------------------------------------
# Networking & CORS (Use '*' or your frontend URL)
# ------------------------------------------------------------------------------
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Upload & Storage Limits
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE=500
ALLOWED_EXTENSIONS=mp4,mkv,webm,mov,avi
UPLOAD_DIR=uploads
THUMBNAIL_DIR=uploads/thumbnails
EXPORTS_DIR=uploads/exports
ANALYTICS_ZERO_BASELINE=true
