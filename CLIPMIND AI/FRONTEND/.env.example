# ==============================================================================
# ClipMind AI - Frontend Client Environment Configuration (.env)
# ==============================================================================

# Backend API Web Service URL (Do NOT include trailing slash)
# Local: http://localhost:8000
# Production: https://your-backend-service.onrender.com
VITE_BACKEND_URL=http://localhost:8000

# Optional WebSocket URL (Derived automatically from VITE_BACKEND_URL if left blank)
# Local: ws://localhost:8000
# Production: wss://your-backend-service.onrender.com
VITE_WS_URL=
